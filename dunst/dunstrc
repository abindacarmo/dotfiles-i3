[global]
    monitor = 0
    follow = none
    width = 320
    height = 120
    origin = top-right
    offset = 15x50
    notification_limit = 5
    padding = 15
    horizontal_padding = 15
    frame_width = 2
    gap_size = 8
    corner_radius = 12
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 32
[urgency_low]
    background = "#0A0612"
    foreground = "#f6e6bc"
    frame_color = "#D6714F"
    timeout = 5
[urgency_normal]
    background = "#0A0612"
    foreground = "#f6e6bc"
    frame_color = "#B7853C"
    timeout = 10
[urgency_critical]
    background = "#0A0612"
    foreground = "#f6e6bc"
    frame_color = "#A98B6F"
    timeout = 0
